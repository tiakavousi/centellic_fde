# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=1024
MAX_RETRIES=2
MODEL_TIMEOUT=30

# Voyage AI
VOYAGEAI_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Azure AI Search (live API) — auth via DefaultAzureCredential (az login)
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_INDEX=retail-banking-chunks
AZURE_SEMANTIC_CONFIG=retail-banking-semantic

# Chroma (eval pipeline only — not used by the live API)
CHROMA_PATH=./chroma_store
CHROMA_COLLECTION=retail_banking_docs

# Retrieval
# RELEVANCE_FLOOR: Chroma cosine similarity gate (0–1 scale), used for local eval
# RERANK_FLOOR: Azure semantic reranker gate (0–4 scale), used for live API
RELEVANCE_FLOOR=0.45
RERANK_FLOOR=1.6
TOP_K=3
EXACT_MATCH_RULE=true

# SLA policy (keep in sync with doc-001: 3 business days to acknowledge, 8 weeks to substantive response)
ACK_WINDOW_DAYS=3
RESPONSE_WINDOW_DAYS=56